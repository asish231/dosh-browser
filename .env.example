ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.7-flash
INCEPTION_API_KEY=
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
INCEPTION_MODEL=mercury-2

# Any OpenAI-compatible endpoint. Both values are required: a key alone does
# not identify the provider, so this family refuses to guess a host and
# reports the missing variable instead.
#   OPENAI_COMPAT_BASE_URL=https://<host>/v1
#   OPENAI_COMPAT_API_KEY=<bearer token>
#   OPENAI_COMPAT_MODEL=<deployment or model id>
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

LLM_MODEL=glm-4.7-flashWEBRESEARCH_BLOCKED_HOSTS=
