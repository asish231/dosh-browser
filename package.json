{
  "name": "agent-browser",
  "version": "0.1.0",
  "description": "An agent-native browser. Every capability is an API.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agent-browser": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./sdk": "./dist/sdk/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts serve",
    "start": "tsx src/index.ts serve",
    "mcp": "tsx src/index.ts mcp",
    "build": "tsc",
    "example": "tsx examples/research.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent",
    "browser",
    "automation",
    "mcp",
    "playwright"
  ],
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "hono": "^4.8.0",
    "playwright": "^1.54.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
