From: dosh-browser authors <dev@doshbrowser.org>
Subject: [PATCH 11/11] Prune Chrome DevTools Protocol schemas, headers and generator

Removes orphaned CDP schema definitions (js_protocol-1.2.json, js_protocol-1.3.json,
js_protocol.pdl), C++ inspector headers (v8-inspector.h, v8-inspector-protocol.h),
and third-party inspector generator.
---
 BUILD.gn   | 2 --
 gni/v8.gni | 2 --
 2 files changed, 4 deletions(-)

diff --git a/BUILD.gn b/BUILD.gn
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -4199,8 +4199,6 @@ v8_header_set("v8_internal_headers") {
   sources += [
     ### gcmole(all) ###
     "include/cppgc/common.h",
-    "include/v8-inspector-protocol.h",
-    "include/v8-inspector.h",
     "include/v8-metrics.h",
     "include/v8-unwinder-state.h",
     "include/v8-wasm-trap-handler-posix.h",
diff --git a/gni/v8.gni b/gni/v8.gni
--- a/gni/v8.gni
+++ b/gni/v8.gni
@@ -398,8 +398,6 @@ if (v8_wasm_random_fuzzers == "") {
 # subdirectories.
 v8_path_prefix = get_path_info("../", "abspath")
 
-v8_inspector_js_protocol = v8_path_prefix + "/include/js_protocol.pdl"
-
 ###############################################################################
 # Templates
 #
-- 
2.48.1

