From: dosh-browser authors <dev@doshbrowser.org>
Subject: [PATCH 5/7] Implement capability gate for WebAssembly installation

Provides isolate-level capability gate to enable/disable WebAssembly
support dynamically, preventing untrusted scripts from instantiating
WASM when the capability is revoked.
---
 src/execution/isolate.h | 10 ++++++++++
 src/wasm/wasm-js.cc     |  5 +++++
 2 files changed, 15 insertions(+)

diff --git a/src/execution/isolate.h b/src/execution/isolate.h
--- a/src/execution/isolate.h
+++ b/src/execution/isolate.h
@@ -2268,6 +2268,12 @@ class V8_EXPORT_PRIVATE Isolate final : private HiddenFactory {
   bool is_eval_allowed() const { return eval_allowed_; }
   void set_eval_allowed(bool allowed) { eval_allowed_ = allowed; }
 
+  bool is_wasm_allowed() const { return wasm_allowed_; }
+  void set_wasm_allowed(bool allowed) { wasm_allowed_ = allowed; }
+
@@ -3100,6 +3106,7 @@ class V8_EXPORT_PRIVATE Isolate final : private HiddenFactory {
   bool eval_allowed_ = true;
+  bool wasm_allowed_ = true;

diff --git a/src/wasm/wasm-js.cc b/src/wasm/wasm-js.cc
--- a/src/wasm/wasm-js.cc
+++ b/src/wasm/wasm-js.cc
@@ -3363,6 +3363,11 @@ void WasmJs::Install(Isolate* isolate) {
+  // doshgentv8 capability gate: if WebAssembly is disallowed on this isolate, suppress installation.
+  if (isolate != nullptr && !isolate->is_wasm_allowed()) {
+    return;
+  }
+
   DirectHandle<JSGlobalObject> global = isolate->global_object();
-- 
